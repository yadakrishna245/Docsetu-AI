# DocSetu AI - Docker Environment Variables
# Copy this file to .env.docker and fill in values before running docker-compose

# Application
APP_NAME=DocSetu-AI
APP_ENV=production
DEBUG=false

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-string

# Database (SQLite path inside container)
DATABASE_URL=sqlite:///app/data/docsetu.db

# Redis
REDIS_URL=redis://redis:6379/0

# Tesseract OCR
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# WhatsApp Bot (if applicable)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# AI/ML (add your API keys here)
OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:80
