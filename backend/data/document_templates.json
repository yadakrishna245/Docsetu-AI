{
  "metadata": {
    "version": "1.0.0",
    "last_updated": "2026-07-29",
    "description": "Common Indian document templates with required fields and compliance mapping",
    "total_templates": 8
  },
  "templates": [
    {
      "template_id": "TPL-001",
      "name": "GST Tax Invoice",
      "category": "Taxation",
      "description": "Standard GST-compliant tax invoice for B2B and B2C transactions",
      "required_fields": [
        {"field": "supplier_name", "type": "string", "description": "Legal name of supplier"},
        {"field": "supplier_gstin", "type": "gstin", "description": "GSTIN of supplier"},
        {"field": "supplier_address", "type": "address", "description": "Full address of supplier with state and PIN"},
        {"field": "invoice_number", "type": "string", "description": "Unique sequential invoice number (max 16 chars, alphanumeric)"},
        {"field": "invoice_date", "type": "date", "description": "Date of issue of invoice"},
        {"field": "recipient_name", "type": "string", "description": "Legal name of recipient"},
        {"field": "recipient_gstin", "type": "gstin", "description": "GSTIN of recipient (mandatory for B2B)"},
        {"field": "recipient_address", "type": "address", "description": "Full address with state code"},
        {"field": "place_of_supply", "type": "state_code", "description": "State code of place of supply"},
        {"field": "hsn_sac_code", "type": "string", "description": "HSN code for goods / SAC code for services"},
        {"field": "item_description", "type": "string", "description": "Description of goods or services"},
        {"field": "quantity", "type": "number", "description": "Quantity of goods"},
        {"field": "unit", "type": "string", "description": "Unit of measurement (UQC)"},
        {"field": "rate", "type": "currency", "description": "Rate per unit"},
        {"field": "taxable_value", "type": "currency", "description": "Total taxable value before tax"},
        {"field": "cgst_rate", "type": "percentage", "description": "CGST rate applicable"},
        {"field": "cgst_amount", "type": "currency", "description": "CGST amount"},
        {"field": "sgst_rate", "type": "percentage", "description": "SGST/UTGST rate applicable"},
        {"field": "sgst_amount", "type": "currency", "description": "SGST/UTGST amount"},
        {"field": "igst_rate", "type": "percentage", "description": "IGST rate (for inter-state)"},
        {"field": "igst_amount", "type": "currency", "description": "IGST amount"},
        {"field": "total_invoice_value", "type": "currency", "description": "Total amount including tax"},
        {"field": "signature", "type": "signature", "description": "Authorized signatory"}
      ],
      "optional_fields": [
        {"field": "irn", "type": "string", "description": "Invoice Reference Number (e-invoice)"},
        {"field": "qr_code", "type": "image", "description": "QR code for e-invoice"},
        {"field": "eway_bill_number", "type": "string", "description": "E-way bill number if applicable"},
        {"field": "delivery_address", "type": "address", "description": "Ship-to address if different"},
        {"field": "payment_terms", "type": "string", "description": "Payment due terms"},
        {"field": "bank_details", "type": "object", "description": "Bank account for payment"},
        {"field": "reverse_charge", "type": "boolean", "description": "Whether reverse charge applicable"},
        {"field": "discount", "type": "currency", "description": "Discount amount if any"},
        {"field": "cess", "type": "currency", "description": "Compensation cess if applicable"},
        {"field": "total_in_words", "type": "string", "description": "Total amount in words"}
      ],
      "compliance_rules_applicable": ["GST-001", "GST-002", "GST-003", "GST-008", "GST-014"]
    },
    {
      "template_id": "TPL-002",
      "name": "Employment Contract / Appointment Letter",
      "category": "Labour & Employment",
      "description": "Standard employment contract for Indian companies covering all statutory requirements",
      "required_fields": [
        {"field": "company_name", "type": "string", "description": "Legal name of employer company"},
        {"field": "company_cin", "type": "cin", "description": "Corporate Identification Number"},
        {"field": "company_address", "type": "address", "description": "Registered office address"},
        {"field": "employee_name", "type": "string", "description": "Full legal name of employee"},
        {"field": "designation", "type": "string", "description": "Job title/designation"},
        {"field": "department", "type": "string", "description": "Department of employment"},
        {"field": "date_of_joining", "type": "date", "description": "Effective date of employment"},
        {"field": "compensation_structure", "type": "object", "description": "Basic, HRA, DA, Special Allowance breakdown"},
        {"field": "ctc", "type": "currency", "description": "Cost to Company (annual)"},
        {"field": "probation_period", "type": "duration", "description": "Probation duration (typically 3-6 months)"},
        {"field": "notice_period", "type": "duration", "description": "Notice period for termination"},
        {"field": "work_location", "type": "address", "description": "Primary work location"},
        {"field": "working_hours", "type": "string", "description": "Working hours and days"},
        {"field": "leave_policy", "type": "object", "description": "Earned leave, casual leave, sick leave entitlements"},
        {"field": "confidentiality_clause", "type": "text", "description": "Confidentiality and IP assignment clause"},
        {"field": "termination_clause", "type": "text", "description": "Grounds and procedure for termination"},
        {"field": "employee_signature", "type": "signature", "description": "Employee acceptance signature"},
        {"field": "employer_signature", "type": "signature", "description": "Authorized signatory of employer"}
      ],
      "optional_fields": [
        {"field": "non_compete_clause", "type": "text", "description": "Non-compete restrictions (limited enforceability in India)"},
        {"field": "relocation_allowance", "type": "currency", "description": "Relocation benefits"},
        {"field": "bonus_structure", "type": "object", "description": "Variable pay/performance bonus details"},
        {"field": "esop_details", "type": "object", "description": "Stock option details if applicable"},
        {"field": "insurance_coverage", "type": "object", "description": "Health/life insurance details"},
        {"field": "background_verification", "type": "text", "description": "BGV clause and conditions"}
      ],
      "compliance_rules_applicable": ["LAB-001", "LAB-002", "LAB-003", "LAB-004", "LAB-005", "LAB-006", "LAB-007", "LAB-008"]
    },
    {
      "template_id": "TPL-003",
      "name": "Rental/Lease Agreement",
      "category": "Real Estate",
      "description": "Standard rental agreement for residential/commercial property in India",
      "required_fields": [
        {"field": "lessor_name", "type": "string", "description": "Full name of property owner/landlord"},
        {"field": "lessor_pan", "type": "pan", "description": "PAN of landlord (required for TDS if rent > 50,000/month)"},
        {"field": "lessor_address", "type": "address", "description": "Permanent address of landlord"},
        {"field": "lessee_name", "type": "string", "description": "Full name of tenant"},
        {"field": "lessee_address", "type": "address", "description": "Current/permanent address of tenant"},
        {"field": "property_address", "type": "address", "description": "Complete address of rented property"},
        {"field": "property_type", "type": "enum", "description": "Residential/Commercial/Industrial"},
        {"field": "monthly_rent", "type": "currency", "description": "Monthly rental amount"},
        {"field": "security_deposit", "type": "currency", "description": "Security deposit amount"},
        {"field": "lease_start_date", "type": "date", "description": "Start date of lease"},
        {"field": "lease_duration", "type": "duration", "description": "Duration of lease (typically 11 months)"},
        {"field": "rent_escalation", "type": "percentage", "description": "Annual rent increase percentage"},
        {"field": "maintenance_charges", "type": "currency", "description": "Monthly maintenance if applicable"},
        {"field": "permitted_use", "type": "string", "description": "Purpose of use (residential/office/etc.)"},
        {"field": "termination_notice", "type": "duration", "description": "Notice period for vacating"},
        {"field": "witness_1", "type": "object", "description": "Name, address, signature of witness 1"},
        {"field": "witness_2", "type": "object", "description": "Name, address, signature of witness 2"},
        {"field": "stamp_duty", "type": "currency", "description": "Stamp duty paid as per state law"},
        {"field": "registration", "type": "boolean", "description": "Whether registered (mandatory if > 11 months)"}
      ],
      "optional_fields": [
        {"field": "furniture_inventory", "type": "array", "description": "List of furniture/fixtures provided"},
        {"field": "pet_policy", "type": "string", "description": "Pet permission clause"},
        {"field": "subletting_clause", "type": "text", "description": "Subletting permissions"},
        {"field": "parking_details", "type": "string", "description": "Parking allocation"},
        {"field": "utility_responsibility", "type": "object", "description": "Who pays electricity, water, gas"}
      ],
      "compliance_rules_applicable": ["GST-012"]
    },
    {
      "template_id": "TPL-004",
      "name": "Power of Attorney",
      "category": "Legal",
      "description": "General or Special Power of Attorney as per Indian law",
      "required_fields": [
        {"field": "principal_name", "type": "string", "description": "Full name of person granting power"},
        {"field": "principal_address", "type": "address", "description": "Address of principal"},
        {"field": "principal_id_proof", "type": "string", "description": "Aadhaar/PAN/Passport of principal"},
        {"field": "attorney_name", "type": "string", "description": "Full name of person receiving power"},
        {"field": "attorney_address", "type": "address", "description": "Address of attorney"},
        {"field": "attorney_id_proof", "type": "string", "description": "ID proof of attorney"},
        {"field": "poa_type", "type": "enum", "description": "General/Special Power of Attorney"},
        {"field": "powers_granted", "type": "array", "description": "Specific powers being delegated"},
        {"field": "effective_date", "type": "date", "description": "Date from which POA is effective"},
        {"field": "property_details", "type": "object", "description": "Property details if related to property (for Special POA)"},
        {"field": "principal_signature", "type": "signature", "description": "Signature of principal"},
        {"field": "witness_1", "type": "object", "description": "Witness 1 details and signature"},
        {"field": "witness_2", "type": "object", "description": "Witness 2 details and signature"},
        {"field": "notarization", "type": "boolean", "description": "Notarized by notary public"},
        {"field": "stamp_duty", "type": "currency", "description": "Stamp duty as per state law"}
      ],
      "optional_fields": [
        {"field": "validity_period", "type": "duration", "description": "Duration of validity if not irrevocable"},
        {"field": "revocation_clause", "type": "text", "description": "Conditions for revocation"},
        {"field": "sub_delegation", "type": "boolean", "description": "Whether attorney can further delegate"},
        {"field": "adjudication", "type": "string", "description": "Adjudication stamp if required by state"}
      ],
      "compliance_rules_applicable": []
    },
    {
      "template_id": "TPL-005",
      "name": "Board Resolution",
      "category": "Corporate Governance",
      "description": "Standard board resolution template for Indian companies",
      "required_fields": [
        {"field": "company_name", "type": "string", "description": "Full legal name of company"},
        {"field": "cin", "type": "cin", "description": "Corporate Identification Number"},
        {"field": "registered_office", "type": "address", "description": "Registered office address"},
        {"field": "meeting_date", "type": "date", "description": "Date of board meeting"},
        {"field": "meeting_time", "type": "time", "description": "Time of meeting"},
        {"field": "meeting_venue", "type": "string", "description": "Venue (physical/video conference)"},
        {"field": "directors_present", "type": "array", "description": "List of directors present with DIN"},
        {"field": "quorum_confirmation", "type": "boolean", "description": "Confirmation that quorum is present"},
        {"field": "chairperson", "type": "object", "description": "Name and DIN of chairperson"},
        {"field": "resolution_text", "type": "text", "description": "Full text of the resolution"},
        {"field": "resolution_type", "type": "enum", "description": "Ordinary/Special Resolution"},
        {"field": "voting_details", "type": "object", "description": "For/Against/Abstained count"},
        {"field": "resolution_status", "type": "enum", "description": "Passed/Not Passed"},
        {"field": "chairman_signature", "type": "signature", "description": "Signature of Chairman"},
        {"field": "company_secretary_signature", "type": "signature", "description": "CS signature and membership number"}
      ],
      "optional_fields": [
        {"field": "directors_absent", "type": "array", "description": "Directors absent with leave"},
        {"field": "invitees", "type": "array", "description": "Non-directors invited to meeting"},
        {"field": "leave_of_absence", "type": "array", "description": "Directors granted leave"},
        {"field": "related_party_disclosure", "type": "text", "description": "RPT disclosures if applicable"},
        {"field": "filing_reference", "type": "string", "description": "MCA form filed pursuant to resolution"}
      ],
      "compliance_rules_applicable": ["MCA-001", "MCA-002", "SEBI-006", "SEBI-008"]
    },
    {
      "template_id": "TPL-006",
      "name": "Memorandum & Articles of Association (MOA/AOA)",
      "category": "Corporate Governance",
      "description": "MOA and AOA template for Indian company incorporation under Companies Act 2013",
      "required_fields": [
        {"field": "company_name", "type": "string", "description": "Proposed company name (with Private Limited/Limited suffix)"},
        {"field": "registered_office_state", "type": "string", "description": "State where registered office situated"},
        {"field": "main_objects", "type": "array", "description": "Main objects of the company"},
        {"field": "objects_incidental", "type": "array", "description": "Objects incidental to main objects"},
        {"field": "liability_clause", "type": "text", "description": "Liability of members (limited by shares/guarantee)"},
        {"field": "authorized_capital", "type": "currency", "description": "Authorized share capital"},
        {"field": "share_structure", "type": "object", "description": "Number and face value of shares"},
        {"field": "subscriber_details", "type": "array", "description": "Name, address, shares of each subscriber"},
        {"field": "subscriber_signatures", "type": "array", "description": "Signatures of all subscribers"},
        {"field": "witness_details", "type": "object", "description": "Witness to subscriber signatures"},
        {"field": "aoa_table", "type": "enum", "description": "Applicable Table (Table F for company limited by shares)"},
        {"field": "share_transfer_restrictions", "type": "text", "description": "Transfer restrictions (for Private Ltd)"},
        {"field": "director_appointment_rules", "type": "text", "description": "Rules for appointment of first directors"},
        {"field": "meeting_rules", "type": "text", "description": "Rules for general and board meetings"}
      ],
      "optional_fields": [
        {"field": "special_rights", "type": "text", "description": "Special rights attached to any class of shares"},
        {"field": "alteration_clause", "type": "text", "description": "Procedure for alteration of MOA/AOA"},
        {"field": "winding_up_clause", "type": "text", "description": "Rules for voluntary winding up"},
        {"field": "indemnity_clause", "type": "text", "description": "Indemnification of directors/officers"},
        {"field": "borrowing_powers", "type": "text", "description": "Borrowing power limits of board"}
      ],
      "compliance_rules_applicable": ["MCA-006", "MCA-007", "MCA-008", "MCA-010"]
    },
    {
      "template_id": "TPL-007",
      "name": "Non-Disclosure Agreement (NDA)",
      "category": "Legal",
      "description": "Standard bilateral or unilateral NDA template for Indian jurisdiction",
      "required_fields": [
        {"field": "disclosing_party_name", "type": "string", "description": "Name of disclosing party"},
        {"field": "disclosing_party_address", "type": "address", "description": "Address of disclosing party"},
        {"field": "receiving_party_name", "type": "string", "description": "Name of receiving party"},
        {"field": "receiving_party_address", "type": "address", "description": "Address of receiving party"},
        {"field": "effective_date", "type": "date", "description": "Date NDA becomes effective"},
        {"field": "purpose", "type": "text", "description": "Purpose for which confidential information is shared"},
        {"field": "definition_of_confidential_info", "type": "text", "description": "Clear definition of what constitutes confidential information"},
        {"field": "exclusions", "type": "array", "description": "What is excluded from confidential information"},
        {"field": "obligations", "type": "text", "description": "Obligations of receiving party"},
        {"field": "term", "type": "duration", "description": "Duration of NDA"},
        {"field": "survival_period", "type": "duration", "description": "Period obligations survive after termination"},
        {"field": "governing_law", "type": "string", "description": "Governing law (Indian state)"},
        {"field": "jurisdiction", "type": "string", "description": "Courts having jurisdiction"},
        {"field": "dispute_resolution", "type": "text", "description": "Arbitration/mediation clause"},
        {"field": "signatures", "type": "array", "description": "Signatures of both parties with date"}
      ],
      "optional_fields": [
        {"field": "nda_type", "type": "enum", "description": "Unilateral/Bilateral/Multilateral"},
        {"field": "non_solicitation", "type": "text", "description": "Non-solicitation of employees clause"},
        {"field": "return_of_materials", "type": "text", "description": "Obligation to return/destroy materials"},
        {"field": "injunctive_relief", "type": "text", "description": "Right to seek injunctive relief"},
        {"field": "penalty_clause", "type": "currency", "description": "Liquidated damages for breach"},
        {"field": "data_protection", "type": "text", "description": "DPDP Act compliance clause"}
      ],
      "compliance_rules_applicable": ["DPDP-001", "DPDP-007", "DPDP-008"]
    },
    {
      "template_id": "TPL-008",
      "name": "Vendor/Service Agreement",
      "category": "Commercial",
      "description": "Standard vendor or service agreement template for Indian businesses",
      "required_fields": [
        {"field": "client_name", "type": "string", "description": "Name of client company"},
        {"field": "client_cin_gstin", "type": "string", "description": "CIN/GSTIN of client"},
        {"field": "client_address", "type": "address", "description": "Registered address of client"},
        {"field": "vendor_name", "type": "string", "description": "Name of vendor/service provider"},
        {"field": "vendor_gstin", "type": "gstin", "description": "GSTIN of vendor"},
        {"field": "vendor_pan", "type": "pan", "description": "PAN of vendor"},
        {"field": "vendor_address", "type": "address", "description": "Address of vendor"},
        {"field": "scope_of_work", "type": "text", "description": "Detailed scope of services/deliverables"},
        {"field": "contract_value", "type": "currency", "description": "Total contract value"},
        {"field": "payment_terms", "type": "object", "description": "Payment schedule, milestones, terms"},
        {"field": "gst_treatment", "type": "object", "description": "GST applicability, rate, reverse charge"},
        {"field": "tds_clause", "type": "object", "description": "TDS deduction details (Section 194C/194J/194H)"},
        {"field": "term", "type": "duration", "description": "Contract duration"},
        {"field": "deliverables", "type": "array", "description": "List of deliverables with timelines"},
        {"field": "sla_terms", "type": "object", "description": "Service Level Agreement terms"},
        {"field": "termination_clause", "type": "text", "description": "Termination conditions and notice period"},
        {"field": "indemnity", "type": "text", "description": "Indemnification clause"},
        {"field": "governing_law", "type": "string", "description": "Governing law and jurisdiction"},
        {"field": "signatures", "type": "array", "description": "Authorized signatures of both parties"}
      ],
      "optional_fields": [
        {"field": "insurance_requirements", "type": "object", "description": "Insurance vendor must carry"},
        {"field": "ip_ownership", "type": "text", "description": "Intellectual property ownership clause"},
        {"field": "data_processing_addendum", "type": "text", "description": "DPA for data handling (DPDP compliance)"},
        {"field": "force_majeure", "type": "text", "description": "Force majeure clause"},
        {"field": "non_compete", "type": "text", "description": "Non-compete restrictions"},
        {"field": "subcontracting", "type": "text", "description": "Subcontracting permissions"},
        {"field": "audit_rights", "type": "text", "description": "Client's right to audit vendor"},
        {"field": "penalty_clause", "type": "object", "description": "Penalty for delays/non-performance"}
      ],
      "compliance_rules_applicable": ["GST-001", "GST-003", "GST-012", "GST-015", "DPDP-001", "DPDP-007"]
    }
  ]
}
