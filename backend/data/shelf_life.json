    "october": ["ITR audit cases (31st)", "TP Report 3CEB (31st)", "LLP Form 8 (30th)"],
    "november": ["ITR TP cases (30th)", "ITC claim deadline (30th)", "Credit note deadline (30th)"],
    "december": ["GSTR-9 Annual Return (31st)", "Half-year financial results for listed cos"]
  }
