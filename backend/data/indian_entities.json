    "TAN": {
      "name": "Tax Deduction and Collection Account Number",
      "issuing_authority": "Income Tax Department, India",
      "format": "AAAA99999A",
      "length": 10,
      "regex": "^[A-Z]{4}[0-9]{5}[A-Z]$",
      "validation_rules": {
        "position_1_3": "City/Area code (first 3 letters)",
        "position_4": "First letter of deductor name",
        "position_5_9": "Sequential number",
        "position_10": "Alphabetic check character"
