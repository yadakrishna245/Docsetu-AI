    "PAN": {
      "name": "Permanent Account Number",
      "issuing_authority": "Income Tax Department, India",
      "format": "AAAAA9999A",
      "length": 10,
      "regex": "^[A-Z]{3}[ABCFGHLJPT][A-Z][0-9]{4}[A-Z]$",
      "validation_rules": {
        "position_1_3": "Alphabetic series AAA-ZZZ",
        "position_4": "Entity type: A=AOP, B=BOI, C=Company, F=Firm, G=Government, H=HUF, L=Local Authority, J=Artificial Juridical Person, P=Individual, T=Trust",
        "position_5": "First letter of surname/entity name",
        "position_6_9": "Sequential number 0001-9999",
        "position_10": "Alphabetic check digit"
      },
      "entity_type_codes": {
        "A": "Association of Persons",
        "B": "Body of Individuals",
        "C": "Company",
        "F": "Firm/LLP",
        "G": "Government",
        "H": "Hindu Undivided Family",
        "L": "Local Authority",
        "J": "Artificial Juridical Person",
        "P": "Individual/Person",
        "T": "Trust"
      },
      "examples": ["ABCPD1234E", "AAACR5678M"],
      "context_keywords": ["PAN", "permanent account number", "income tax", "pan card"]
    },
