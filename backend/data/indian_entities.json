      "operator_prefixes": {
        "6": "Recently allocated (Jio and others)",
        "7": "Multiple operators (Jio, Airtel, Vi)",
        "8": "Multiple operators (Airtel, BSNL, Jio)",
        "9": "Legacy allocations (Airtel, Vi, BSNL)"
      },
      "landline_format": {
        "regex": "^(0[1-9][0-9]{1,2})[\\s-]?[0-9]{6,8}$",
        "description": "STD code (2-4 digits with leading 0) + number (6-8 digits)"
