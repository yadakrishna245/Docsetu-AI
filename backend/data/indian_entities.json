    "EPFO_MEMBER_ID": {
      "name": "EPFO Member ID (PF Number)",
      "issuing_authority": "EPFO",
      "format": "AA/AAA/9999999/999/9999999",
      "length_variable": true,
      "regex": "^[A-Z]{2}\\/[A-Z]{3}\\/[0-9]{7}\\/[0-9]{3}\\/[0-9]{7}$",
      "validation_rules": {
        "part_1": "State code (2 letters)",
        "part_2": "Regional office code (3 letters)",
        "part_3": "Establishment code (7 digits)",
        "part_4": "Extension (3 digits)",
        "part_5": "Member serial number (7 digits)"
      },
      "examples": ["MH/BOM/1234567/000/0001234", "KA/BNG/9876543/001/0005678"],
      "context_keywords": ["PF number", "member ID", "EPF number", "provident fund number", "EPFO member"]
    },
    "PHONE_INDIA": {
      "name": "Indian Mobile/Phone Number",
      "issuing_authority": "Department of Telecommunications (DoT)",
      "format": "+91 99999 99999",
      "length": 10,
      "regex": "^(\\+91[\\s-]?)?[6-9][0-9]{9}$",
      "validation_rules": {
        "first_digit": "Must be 6, 7, 8, or 9",
