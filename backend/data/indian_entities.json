    "AADHAAR": {
      "name": "Aadhaar Number",
      "issuing_authority": "Unique Identification Authority of India (UIDAI)",
      "format": "9999 9999 9999",
      "length": 12,
      "regex": "^[2-9][0-9]{3}\\s?[0-9]{4}\\s?[0-9]{4}$",
      "validation_rules": {
        "first_digit": "Cannot be 0 or 1",
        "checksum": "Verhoeff algorithm on last digit",
        "format": "12 digits, often displayed as groups of 4"
      },
      "verhoeff_checksum": {
        "description": "The 12th digit is a Verhoeff checksum computed over the first 11 digits",
        "multiplication_table": "d5 table",
        "permutation_table": "p8 table",
        "inverse_table": "inv table",
        "validation": "Apply Verhoeff algorithm; result should be 0"
      },
      "virtual_id": {
        "format": "16-digit number",
        "regex": "^[0-9]{16}$",
        "description": "Temporary 16-digit Virtual ID mapped to Aadhaar for privacy-preserving authentication"
      },
      "examples": ["2345 6789 0123", "9876 5432 1098"],
      "context_keywords": ["Aadhaar", "UIDAI", "aadhaar number", "unique identification"]
    },
