    "UAN": {
      "name": "Universal Account Number",
      "issuing_authority": "Employees' Provident Fund Organisation (EPFO)",
      "format": "999999999999",
      "length": 12,
      "regex": "^[0-9]{12}$",
      "validation_rules": {
        "type": "12-digit numeric",
        "uniqueness": "One per employee for lifetime, portable across employers",
