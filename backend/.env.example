# ============================================================
# DocSetu AI - Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=DocSetu AI
APP_ENV=development          # development | staging | production
DEBUG=True                   # Set to False in production
SECRET_KEY=change-this-in-production   # Generate a strong random key for production
API_VERSION=v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./docsetu.db
# For PostgreSQL: postgresql://user:password@localhost:5432/docsetu

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# --- LLM Provider ---
LLM_PROVIDER=openai          # openai | gemini

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-jwt-secret   # Generate a strong random key for production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp

# --- OCR (Tesseract) ---
TESSERACT_CMD=tesseract
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS (Homebrew): TESSERACT_CMD=/usr/local/bin/tesseract
TESSERACT_LANG=eng+hin+tam+tel+kan

# --- ChromaDB (Vector Store) ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Celery (Background Tasks - not actively used yet) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=./logs/docsetu.log

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list of allowed origins

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com     # Your SMTP server (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_PORT=587                # 587 for TLS, 465 for SSL
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# For Gmail: Use an App Password, not your account password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_FROM_EMAIL=noreply@docsetu.ai
APP_BASE_URL=http://localhost:3000   # Used in email links (password reset, verification)

# --- Razorpay (Payments) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Get keys from: https://dashboard.razorpay.com/app/keys
