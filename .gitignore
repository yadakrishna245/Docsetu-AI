# ═══════════════════════════════════════════
# DocSetu AI - .gitignore
# ═══════════════════════════════════════════

# ─── Python ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environments ───────────────
venv/
.venv/
ENV/
env/
.env/

# ─── Environment Variables ──────────────
.env
.env.local
.env.production
.env.staging
.env.*.local

# ─── Node.js ────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ─── Frontend Build ─────────────────────
frontend/dist/
frontend/build/
.next/
out/

# ─── IDE / Editors ──────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ─── OS Files ───────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Testing ────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ─── ML Models ──────────────────────────
models/
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.bin
!models/.gitkeep

# ─── Data & Uploads ─────────────────────
uploads/
data/raw/
data/processed/
*.csv
*.xlsx
!data/seeds/*.csv

# ─── Logs ───────────────────────────────
logs/
*.log

# ─── Docker ─────────────────────────────
docker-compose.override.yml

# ─── Terraform ──────────────────────────
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/*.tfvars
infrastructure/terraform/**/crash.log

# ─── Secrets & Keys ─────────────────────
*.pem
*.key
*.cert
*.crt
secrets/
credentials.json
service-account.json

# ─── Database ───────────────────────────
*.sql
*.sqlite3
*.db
!migrations/**/*.sql

# ─── Misc ───────────────────────────────
.vercel
.netlify
*.bak
*.tmp
*.temp

test_uploads/
