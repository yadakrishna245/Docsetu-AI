# DocSetu AI WhatsApp Bot - Environment Variables

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_KEY=your_api_key_here
API_TIMEOUT=30000

# Bot Configuration
MAX_FILE_SIZE_MB=16

# Rate Limiting
RATE_LIMIT_PER_MIN=10
DOC_LIMIT_PER_HOUR=20

# Server
PORT=3001

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bot.log

# Optional: Webhook for notifications
WEBHOOK_URL=
WEBHOOK_SECRET=
